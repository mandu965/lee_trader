# Copy this file to .env and fill in your real secrets before running docker compose
# IMPORTANT: Do NOT commit your real .env to version control

# KIS virtual trading base URL (VTS). For real trading, change to production URL as needed.
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# Korea Investment & Securities API credentials (KEEP SECRET)
KIS_APP_KEY=YOUR_APP_KEY
KIS_APP_SECRET=YOUR_APP_SECRET
KIS_APP_ID=YOUR_ACCOUNT_ID
KIS_APP_PASSWORD=YOUR_ACCOUNT_PASSWORD
KIS_APP_RULE_ID=YOUR_RULE_ACCOUNT_ID
KIS_APP_RULE_PASSWORD=YOUR_RULE_ACCOUNT_PASSWORD
KIS_RULE_CANO=YOUR_RULE_CANO
KIS_RULE_ACNT_PRDT_CD=YOUR_RULE_ACCOUNT_PRODUCT_CODE
KIS_TIMEOUT_SEC=35
KIS_MAX_RETRIES=4
KIS_RETRY_BACKOFF_BASE_SEC=2
KIS_RETRY_BACKOFF_MAX_SEC=8

# Rule-based trading safety defaults. Keep disabled unless explicitly piloting.
RULE_TRADING_RUN_MODE=paper
RULE_LIVE_ENABLED=0
RULE_ORDER_SUBMIT_ENABLED=0
ACTIVE_TRADING_ENGINE=ai
RULE_MIN_TRADING_VALUE_MA20_PAPER=500000000
RULE_MIN_TRADING_VALUE_MA20_PILOT=1000000000
RULE_MIN_TRADING_VALUE_MA20_LIVE=2000000000
RULE_ENTRY_RULE_SCORE_MIN=70
RULE_ENTRY_RULE_SCORE_V2_MIN=65
RULE_STRONG_RULE_SCORE_MIN=70
RULE_STRONG_RULE_SCORE_V2_MIN=50
RULE_MAX_POSITIONS=5
RULE_MAX_POSITION_WEIGHT=0.15
RULE_NEW_ENTRY_WEIGHT=0.05
RULE_MIN_CASH_WEIGHT=0.20
RULE_MAX_SECTOR_WEIGHT=0.35
RULE_COOLDOWN_DAYS=5
RULE_MIN_ORDER_AMOUNT=100000
MARKET_ORDER_ENABLED=0
RULE_RETRY_ENABLED=1
RULE_MAX_RETRY_COUNT=1
RULE_BUY_FALLBACK_LIMIT_BUFFER=0.015
RULE_SELL_FALLBACK_LIMIT_BUFFER=0.015
RULE_MAX_FALLBACK_PRICE_DRIFT=0.02
RULE_TRADING_CALENDAR_PATH=config/trading_calendar_kr.json
RULE_BEFORE_OPEN_START_TIME=08:55
RULE_BEFORE_OPEN_END_TIME=09:30
RULE_BLOCK_ON_MISSING_RECONCILIATION=1
RULE_PAPER_ALLOW_MISSING_RECONCILIATION=0
RULE_OPEN_SNAPSHOT_MAX_RETRY=3
RULE_OPEN_SNAPSHOT_RETRY_INTERVAL_SEC=10
NAVER_FALLBACK_VERIFY_SSL=0
NAVER_FALLBACK_TIMEOUT_SEC=20

# Node runtime environment
NODE_ENV=development
SITE_BASE_URL=http://localhost:3000

# Optional: default symbols universe (comma-separated)
SYMBOLS=005930,000660,035420,051910,207940,068270,035720,005380,066570,005490

# Postgres (local docker)
POSTGRES_USER=lee_trader
POSTGRES_PASSWORD=lee_trader_pw
POSTGRES_DB=lee_trader
DATABASE_URL=postgresql://lee_trader:lee_trader_pw@localhost:5432/lee_trader
DATABASE_URL_DOCKER=postgresql://lee_trader:lee_trader_pw@postgres:5432/lee_trader
WEB_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
PG_POOL_SIZE=5
PG_MAX_OVERFLOW=2
PG_POOL_TIMEOUT=5
PG_POOL_RECYCLE=1800
PG_CONNECT_TIMEOUT=5

# Scheduler
SCHEDULER_DAILY_TIME=16:00
SCHEDULER_POLL_SECONDS=30
SCHEDULER_SKIP_CATCHUP_ON_START=1
SCHEDULER_RUN_POLICY=always
SCHEDULER_SYNC_WEB_DISPLAY=1

# Midday refresh scheduler
SCHEDULER_RECOVERY_DAILY_TIME=12:00
SCHEDULER_RECOVERY_POLL_SECONDS=30
SCHEDULER_RECOVERY_SKIP_CATCHUP_ON_START=1
SCHEDULER_RECOVERY_RUN_POLICY=always
SCHEDULER_PRIMARY_MAX_AGE_HOURS=20
