# Copy this file to .env and fill in your real secrets before running docker compose
# IMPORTANT: Do NOT commit your real .env to version control

# KIS virtual trading base URL (VTS). For real trading, change to production URL as needed.
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# Korea Investment & Securities API credentials (KEEP SECRET)
KIS_APP_KEY=YOUR_APP_KEY
KIS_APP_SECRET=YOUR_APP_SECRET
KIS_APP_ID=YOUR_ACCOUNT_ID
KIS_APP_PASSWORD=YOUR_ACCOUNT_PASSWORD
KIS_APP_RULE_ID=YOUR_RULE_ACCOUNT_ID
KIS_APP_RULE_PASSWORD=YOUR_RULE_ACCOUNT_PASSWORD
KIS_RULE_CANO=YOUR_RULE_CANO
KIS_RULE_ACNT_PRDT_CD=YOUR_RULE_ACCOUNT_PRODUCT_CODE
KIS_TIMEOUT_SEC=35
# Preferred retry variable names (KIS_MAX_RETRIES / KIS_RETRY_BACKOFF_BASE_SEC are legacy fallbacks)
KIS_MAX_RETRY=3
KIS_RETRY_WAIT_SEC=1
KIS_RETRY_BACKOFF_FACTOR=2
KIS_RETRY_BACKOFF_MAX_SEC=30
# Legacy names (still accepted; new names above take precedence)
KIS_MAX_RETRIES=3
KIS_RETRY_BACKOFF_BASE_SEC=1

# Rule-based trading safety defaults. Keep disabled unless explicitly piloting.
RULE_TRADING_RUN_MODE=paper
RULE_LIVE_ENABLED=0
RULE_ORDER_SUBMIT_ENABLED=0
ACTIVE_TRADING_ENGINE=ai
RULE_MIN_TRADING_VALUE_MA20_PAPER=500000000
RULE_MIN_TRADING_VALUE_MA20_PILOT=1000000000
RULE_MIN_TRADING_VALUE_MA20_LIVE=2000000000
RULE_ENTRY_RULE_SCORE_MIN=70
RULE_ENTRY_RULE_SCORE_V2_MIN=65
RULE_STRONG_RULE_SCORE_MIN=70
RULE_STRONG_RULE_SCORE_V2_MIN=50
RULE_MAX_POSITIONS=5
RULE_MAX_POSITION_WEIGHT=0.15
RULE_NEW_ENTRY_WEIGHT=0.05
RULE_MIN_CASH_WEIGHT=0.20
RULE_MAX_SECTOR_WEIGHT=0.35
RULE_COOLDOWN_DAYS=5
RULE_ALLOW_ENTRY_SIGNAL=0
RULE_ENTRY_ALLOW_RATIO=0.6
RULE_MAX_HOLDING_DAYS_DEFENSIVE=7
RULE_PROFIT_TARGET_PCT=0.0
RULE_MIN_ORDER_AMOUNT=100000
MARKET_ORDER_ENABLED=0
# 주문 재시도 (KISAuthError·429·ConnectionRefused 에 한해 재시도 — 중복 주문 방지를 위해 timeout/5xx는 제외)
RULE_RETRY_ENABLED=1
RULE_MAX_RETRY_COUNT=1
RULE_PARTIAL_FILL_TOPUP_ENABLED=0
RULE_BUY_LIMIT_BUFFER=0.01
RULE_BUY_LIMIT_BUFFER_HIGH_VOL=0.02
RULE_BUY_FALLBACK_LIMIT_BUFFER=0.015
RULE_SELL_FALLBACK_LIMIT_BUFFER=0.015
RULE_MAX_FALLBACK_PRICE_DRIFT=0.02
RULE_TRADING_CALENDAR_PATH=config/trading_calendar_kr.json
# before_open 스케줄러 실행 시각 — 09:00 장 개시 후 시가 확정을 위해 09:05 권장
# 08:55 실행 시 stck_oprc=0 → actual_open_gap_unavailable 차단 발생
SCHEDULER_RULE_BEFORE_OPEN_DAILY_TIME=09:05
RULE_BEFORE_OPEN_START_TIME=08:55
RULE_BEFORE_OPEN_END_TIME=09:30
RULE_BLOCK_ON_MISSING_RECONCILIATION=1
RULE_PAPER_ALLOW_MISSING_RECONCILIATION=0
RULE_OPEN_SNAPSHOT_MAX_RETRY=3
RULE_OPEN_SNAPSHOT_RETRY_INTERVAL_SEC=10
# Actual open gap guard thresholds (BUY side only)
# 시가 갭 +5% 초과 상승 차단 / -4% 초과 하락 차단
RULE_BUY_MAX_ACTUAL_OPEN_GAP=0.05
RULE_BUY_MIN_ACTUAL_OPEN_GAP=-0.04
# 시가 데이터 없을 때 안전 차단 여부 (1=차단, 0=통과)
RULE_BLOCK_ON_OPEN_GAP_UNAVAILABLE=1
NAVER_FALLBACK_VERIFY_SSL=0
NAVER_FALLBACK_TIMEOUT_SEC=20

# KRX 데이터포털 자격증명 (pykrx 투자자별 수급 데이터 수집용)
# data.krx.co.kr 무료 회원가입 후 설정
# 설정 시: fetch_flow_pykrx.py 로 1년치 이상 수급 데이터 수집 가능
KRX_ID=YOUR_KRX_ID
KRX_PW=YOUR_KRX_PASSWORD

# 수급 데이터 수집 제어
# 0 = 매일 종가 배치에서 KIS API로 수급 데이터 수집 활성
# 1 = 건너뜀
RUN_PIPELINE_SKIP_FLOW_INGESTION=0
# 0 = US 랭킹 테이블 웹 sync 비활성 (recommend.us_stock_rank_daily)
# 1 = 활성
SYNC_WEB_US_RANKING=0

# Node runtime environment
NODE_ENV=development
SITE_BASE_URL=http://localhost:3000

# Optional: default symbols universe (comma-separated)
SYMBOLS=005930,000660,035420,051910,207940,068270,035720,005380,066570,005490

# Postgres (local docker)
POSTGRES_USER=lee_trader
POSTGRES_PASSWORD=lee_trader_pw
POSTGRES_DB=lee_trader
DATABASE_URL=postgresql://lee_trader:lee_trader_pw@localhost:5432/lee_trader
DATABASE_URL_DOCKER=postgresql://lee_trader:lee_trader_pw@postgres:5432/lee_trader
WEB_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
PG_POOL_SIZE=5
PG_MAX_OVERFLOW=2
PG_POOL_TIMEOUT=5
PG_POOL_RECYCLE=1800
PG_CONNECT_TIMEOUT=5

# Score formula version feature flag (leave blank to use config/production_v1.yaml metadata.score_formula_version)
# Operational mode guard in ranking_builder.py prevents accidental formula switch in production.
# To activate a new formula version: set this value AND update resolve_score_formula_version() in ranking_builder.py.
SCORE_FORMULA_VERSION=

# Scheduler
SCHEDULER_DAILY_TIME=16:00
SCHEDULER_POLL_SECONDS=30
SCHEDULER_SKIP_CATCHUP_ON_START=1
SCHEDULER_RUN_POLICY=always
SCHEDULER_SYNC_WEB_DISPLAY=1
# ── 알림 채널 (과제 4-B) ──────────────────────────────────────────────────
# 설정된 채널에만 발송. 미설정 시 콘솔 출력으로 fallback.
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_USER=
ALERT_EMAIL_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_MIN_SCORE_THRESHOLD=40
ALERT_LOG_PATH=outputs/alert_log.json
ALERT_LOG_MAX_ENTRIES=200

# Midday refresh scheduler
SCHEDULER_RECOVERY_DAILY_TIME=12:00
SCHEDULER_RECOVERY_POLL_SECONDS=30
SCHEDULER_RECOVERY_SKIP_CATCHUP_ON_START=1
SCHEDULER_RECOVERY_RUN_POLICY=always
SCHEDULER_PRIMARY_MAX_AGE_HOURS=20

# ── US Macro Overlay (Phase 1~5) ─────────────────────────────────────────────
# Phase 1~2: 데이터 수집 + feature 생성 (주문 영향 없음)
# Phase 3:   Shadow Mode 로그 (주문 영향 없음)
# Phase 4:   백테스트 검증 (주문 영향 없음)
# Phase 5:   실반영 — RULE 자동매매에만 적용 (아래 활성화 방법 참조)
#
# ▶ Phase 5 실반영 활성화 방법 (RULE 자동매매 한정):
#   1) US_MACRO_SHADOW_MODE=0  (Shadow 해제)
#   2) US_MACRO_ALLOW_REAL_APPLY=1  (실반영 허용)
#   두 값을 모두 변경해야 실제 BUY 차단이 작동합니다.
#   하나라도 기본값이면 Shadow 로그만 기록되고 주문에는 영향이 없습니다.

# Master switch. Set to 0 to disable all US macro overlay processing.
US_MACRO_ENABLED=1

# Shadow mode: 0이면 real apply 가능. 반드시 US_MACRO_ALLOW_REAL_APPLY=1 과 함께 변경.
# Phase 5 실반영 시: US_MACRO_SHADOW_MODE=0
US_MACRO_SHADOW_MODE=1

# Data source adapter. Supported: yfinance (default). Future: polygon, alpaca.
US_MACRO_DATA_SOURCE=yfinance

# Comma-separated list of tickers to collect. Leave blank to use built-in default list.
# Default: SPY,QQQ,DIA,XLK,XLF,XLE,XLV,XLI,XLY,XLP,SMH,^VIX,DX-Y.NYB,^TNX
US_MACRO_TICKERS=

# Risk-off thresholds: flag as RISK_OFF if QQQ or SPY 1d return falls below these.
US_MACRO_RISK_OFF_QQQ_RET=-0.015
US_MACRO_RISK_OFF_SPY_RET=-0.012

# VIX spike: flag if VIX 1d return exceeds this (e.g. 0.10 = +10%).
US_MACRO_VIX_SPIKE_RET=0.10

# Semiconductor strength flags (SMH/SOXX 1d return vs thresholds).
US_MACRO_SEMI_POSITIVE_RET=0.01
US_MACRO_SEMI_NEGATIVE_RET=-0.01

# Sector breadth thresholds (ratio of sectors with positive 1d return).
US_MACRO_SECTOR_BREADTH_RISK_OFF_RATIO=0.3
US_MACRO_SECTOR_BREADTH_RISK_ON_RATIO=0.6

# Score adjustment caps.
US_MACRO_MAX_POSITIVE_ADJUST=5.0
US_MACRO_MAX_NEGATIVE_ADJUST=-10.0

# Data staleness limit: macro data older than this many calendar days is ignored.
US_MACRO_STALE_DAYS_LIMIT=3

# Safety guard: 1 = allow macro overlay to block real RULE buys (Phase 5).
# Must set US_MACRO_SHADOW_MODE=0 AND US_MACRO_ALLOW_REAL_APPLY=1 together.
US_MACRO_ALLOW_REAL_APPLY=0

# US Macro Overlay schedulers (Docker services)
# scheduler-us-macro: Phase 1+2 data collection (07:30 KST)
SCHEDULER_US_MACRO_DAILY_TIME=07:30
SCHEDULER_US_MACRO_POLL_SECONDS=60
SCHEDULER_US_MACRO_SKIP_CATCHUP_ON_START=1
SCHEDULER_US_MACRO_RUN_POLICY=always
SCHEDULER_US_MACRO_STATUS_PATH=outputs/us_macro_scheduler_status.json
SCHEDULER_US_MACRO_LOG_PATH=logs/us_macro_scheduler.log
US_MACRO_SCHEDULER_LOOKBACK_DAYS=2
# scheduler-us-macro-shadow: Phase 3 shadow overlay (08:50 KST)
SCHEDULER_US_MACRO_SHADOW_DAILY_TIME=08:50
SCHEDULER_US_MACRO_SHADOW_POLL_SECONDS=60
SCHEDULER_US_MACRO_SHADOW_SKIP_CATCHUP_ON_START=1
SCHEDULER_US_MACRO_SHADOW_RUN_POLICY=always
SCHEDULER_US_MACRO_SHADOW_STATUS_PATH=outputs/us_macro_shadow_scheduler_status.json
SCHEDULER_US_MACRO_SHADOW_LOG_PATH=logs/us_macro_shadow_scheduler.log

# ─── US Macro Overlay Backtest (Phase 4) ────────────────────────────────────
# 이 설정들은 backtest 전용입니다. 실제 자동매매에는 영향을 주지 않습니다.

# 백테스트 기본 룩백 기간 (일)
US_MACRO_BACKTEST_DEFAULT_LOOKBACK_DAYS=365

# 기본 TopN 설정 (콤마 구분)
US_MACRO_BACKTEST_TOP_N=5,10

# 기본 보유기간 설정 (콤마 구분, 단위: 영업일)
US_MACRO_BACKTEST_HOLDING_DAYS=1,5,20,60

# 백테스트 리포트 저장 디렉터리
US_MACRO_BACKTEST_REPORT_DIR=reports

# =========================================================
# Project C - US Stock Recommendation v1 (Phase 1 foundation)
# =========================================================
# This section is reserved for US stock data pipeline preparation only.
# No paper trading, live trading, or AI/ML model training is implemented in this phase.
US_STOCK_ENABLED=false
US_STOCK_UNIVERSE=NASDAQ100
US_STOCK_DATA_SOURCE=yfinance
US_STOCK_PRICE_BACKFILL_YEARS=5
US_STOCK_PRICE_START_DATE=
US_STOCK_PRICE_END_DATE=
US_STOCK_STALE_DAYS_LIMIT=3
US_STOCK_BATCH_SIZE=20
US_STOCK_REQUEST_SLEEP_SEC=1
US_PAPER_TRADING_ENABLED=false
US_LIVE_BROKER=none           # none | KIS_OVERSEAS | ALPACA | IBKR

# KIS 해외주식 브로커 (US_LIVE_BROKER=KIS_OVERSEAS 사용 시)
KIS_US_EXCD=NASD              # NASD | NYSE | AMEX
# KIS_US_APP_KEY=             # 해외 전용 App Key (비우면 KIS_APP_KEY 공유)
# KIS_US_APP_SECRET=
# KIS_US_CANO=                # 해외 전용 계좌번호 (비우면 KIS_CANO 공유)
# KIS_US_ACNT_PRDT_CD=01

# US 실거래 게이트 (모두 비활성이 기본값)
US_MICRO_ALLOW_LIVE=false
US_MICRO_REAL_ORDER_BLOCKED=true
US_LIVE_MAX_ORDER_AMOUNT_USD=500
US_LIVE_MAX_DAILY_ORDER_COUNT=5
US_LIVE_MAX_DAILY_NEW_BUYS=2

# =========================================================
# Project C - US Stock Financial Data v1 (Phase 2-1 design)
# =========================================================
# Design only. No collector, scheduler, paper trading, live trading,
# AI/ML model training, or ranking logic is enabled in this phase.
US_FINANCIAL_COLLECT_ENABLED=0
US_FINANCIAL_SOURCE=yfinance
US_FINANCIAL_PERIOD_TYPES=annual,quarterly
US_FINANCIAL_LOOKBACK_YEARS=5
US_FINANCIAL_MAX_TICKERS_PER_RUN=100
US_FINANCIAL_SLEEP_SEC=1.0
US_FINANCIAL_RETRY_COUNT=3
US_FINANCIAL_RETRY_SLEEP_SEC=5
US_FINANCIAL_FAIL_FAST=0
US_FINANCIAL_WRITE_MODE=upsert
US_FINANCIAL_LOG_LEVEL=INFO

# =========================================================
# Project C - US Stock Financial Feature Builder (Phase 2-3)
# =========================================================
# Standalone financial feature generation only.
# No model training, ranking integration, paper trading, or live trading.
US_FINANCIAL_FEATURE_BUILD_ENABLED=0
US_FINANCIAL_FEATURE_SOURCE_STATEMENT_TABLE=raw.us_stock_financial_statement
US_FINANCIAL_FEATURE_SOURCE_METRIC_TABLE=raw.us_stock_financial_metric
US_FINANCIAL_FEATURE_TARGET_TABLE=feature.us_stock_financial_feature
US_FINANCIAL_FEATURE_PERIOD_TYPES=annual,quarterly
US_FINANCIAL_FEATURE_LOOKBACK_YEARS=5
US_FINANCIAL_FEATURE_WRITE_MODE=upsert
US_FINANCIAL_FEATURE_LOG_LEVEL=INFO

# =========================================================
# Project C - US Relative Strength Features (Phase 2-4)
# =========================================================
# Standalone relative strength generation only.
# No model training, ranking integration, paper trading, or live trading.
US_RELATIVE_STRENGTH_BUILD_ENABLED=0
US_RELATIVE_STRENGTH_SOURCE_TABLE=market.us_stock_daily_price
US_RELATIVE_STRENGTH_TARGET_TABLE=feature.us_stock_relative_strength_daily
US_RELATIVE_STRENGTH_BENCHMARKS=SPY,QQQ
US_RELATIVE_STRENGTH_WINDOWS=5,20,60,120,252
US_RELATIVE_STRENGTH_PRICE_COLUMN=auto
US_RELATIVE_STRENGTH_WRITE_MODE=upsert
US_RELATIVE_STRENGTH_LOG_LEVEL=INFO

# =========================================================
# Project C - US Labels / Dataset Validation (Phase 2-5)
# =========================================================
# Standalone label generation and dataset validation only.
# No model training, ranking integration, paper trading, or live trading.
US_LABEL_BUILD_ENABLED=0
US_LABEL_SOURCE_PRICE_TABLE=market.us_stock_daily_price
US_LABEL_TARGET_TABLE=label.us_stock_label_daily
US_LABEL_PRICE_COLUMN=auto
US_LABEL_WINDOWS=5,20,60
US_LABEL_TOP_PERCENTILE=0.20
US_LABEL_MIN_UNIVERSE_SIZE=30
US_LABEL_EXCLUDE_BENCHMARKS=SPY,QQQ
US_LABEL_WRITE_MODE=upsert
US_LABEL_LOG_LEVEL=INFO

US_DATASET_VALIDATE_ENABLED=0

# ML ranking (LightGBM-based) — runs after feature build in daily pipeline
# Requires data/us_model.pkl (run python.us.us_model_train first)
US_ML_RANKING_ENABLED=0
US_MODEL_VERSION=v1
# 매수/매도 평가에 사용할 랭킹 소스 (rule_v1 | ml_v1)
US_RANKING_DEFAULT_SOURCE=rule_v1
US_RULE_RANKING_SOURCE=rule_v1
US_DATASET_FEATURE_TABLE=feature.us_stock_feature_daily
US_DATASET_FINANCIAL_FEATURE_TABLE=feature.us_stock_financial_feature
US_DATASET_RELATIVE_STRENGTH_TABLE=feature.us_stock_relative_strength_daily
US_DATASET_LABEL_TABLE=label.us_stock_label_daily
US_DATASET_REPORT_PATH=reports/us_stock_dataset_validation.md
US_DATASET_LOG_LEVEL=INFO

# =========================================================
# Project C - US Recommendation Universe (Phase 3-1)
# =========================================================
US_UNIVERSE_MIN_MARKET_CAP=10000000000
US_UNIVERSE_MIN_AVG_VOLUME=1000000
