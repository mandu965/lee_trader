# Render web service example environment file
# Copy values into the Render Dashboard, not into git.

NODE_ENV=production
TZ=Asia/Seoul

# Public canonical URL used for canonical tags, robots.txt, and sitemap.xml.
SITE_BASE_URL=https://www.leetrader.kr

# Use the Supabase connection string from "Connect".
# For Render web service, prefer the pooler session mode connection string.
DATABASE_URL=postgres://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Operator login password for protected pages/actions.
OPERATOR_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Optional if you want to override Render's generated values.
# OPERATOR_AUTH_SECRET=
# ADMIN_TOKEN=
